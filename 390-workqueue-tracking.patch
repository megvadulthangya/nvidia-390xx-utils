+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Dedicated workqueue for the NVIDIA 390xx kernel module.
+ *
+ * The helper is GPL-licensed because workqueue allocation and destruction
+ * are GPL-only kernel APIs. The proprietary nvidia.ko module uses only the
+ * non-GPL exported queue and flush wrappers below.
+ */
+
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/version.h>
+#include <linux/workqueue.h>
+
+static struct workqueue_struct *nvidia_390xx_wq;
+
+int nvidia_wq_queue(struct work_struct *work);
+void nvidia_wq_flush(void);
+
+int nvidia_wq_queue(struct work_struct *work)
+{
+    return queue_work(nvidia_390xx_wq, work);
+}
+EXPORT_SYMBOL(nvidia_wq_queue);
+
+void nvidia_wq_flush(void)
+{
+    __flush_workqueue(nvidia_390xx_wq);
+}
+EXPORT_SYMBOL(nvidia_wq_flush);
+
+static int __init nvidia_wq_module_init(void)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+    nvidia_390xx_wq = alloc_workqueue("nvidia-390xx", WQ_PERCPU, 0);
+#else
+    nvidia_390xx_wq = alloc_workqueue("nvidia-390xx", 0, 0);
+#endif
+
+    if (nvidia_390xx_wq == NULL)
+        return -ENOMEM;
+
+    return 0;
+}
+
+static void __exit nvidia_wq_module_exit(void)
+{
+    if (nvidia_390xx_wq != NULL)
+    {
+        drain_workqueue(nvidia_390xx_wq);
+        destroy_workqueue(nvidia_390xx_wq);
+        nvidia_390xx_wq = NULL;
+    }
+}
+
+module_init(nvidia_wq_module_init);
+module_exit(nvidia_wq_module_exit);
+
+MODULE_DESCRIPTION("Dedicated workqueue for NVIDIA 390xx");
+MODULE_LICENSE("GPL");
+
