+/*
+ * All NVIDIA work items are placed on a private queue. In particular, do
+ * not flush system_wq/system_percpu_wq: unrelated kernel work such as
+ * delayed_fput may execute NVIDIA file-release paths on those queues.
+ */
+static void nv_workqueue_flush_private_queue(void)
+{
+    nvidia_wq_flush();
+}
+
+int NV_API_CALL nv_workqueue_init(void)
+{
+    unsigned long flags;
+    int status = 0;
+
+    spin_lock_irqsave(&nv_workqueue_state_lock, flags);
+
+    if (nv_workqueue_accepting ||
+        atomic_read(&nv_workqueue_pending) != 0)
+    {
+        status = -EBUSY;
+    }
+    else
+    {
+        nv_workqueue_accepting = NV_TRUE;
+    }
+
+    spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+
+    return status;
+}
+
+void NV_API_CALL nv_workqueue_shutdown(void)
+{
+    unsigned long flags;
+
+    /*
+     * Keep accepting chained work until the NVIDIA pending count reaches
+     * zero. The scheduling function queues work while holding the same
+     * lock, so no accepted item can remain unqueued when we close the gate.
+     */
+    for (;;)
+    {
+        wait_event(nv_workqueue_wait_queue,
+                   atomic_read(&nv_workqueue_pending) == 0);
+
+        spin_lock_irqsave(&nv_workqueue_state_lock, flags);
+
+        if (atomic_read(&nv_workqueue_pending) == 0)
+        {
+            nv_workqueue_accepting = NV_FALSE;
+            spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+            break;
+        }
+
+        spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+    }
+
+    /* Wait for the final callback to return, not merely to decrement pending. */
+    nv_workqueue_flush_private_queue();
+}
+
+int NV_API_CALL nv_workqueue_schedule(nv_task_t *work)
+{
+    unsigned long flags;
+    int queued;
+    int wake = 0;
+
+    spin_lock_irqsave(&nv_workqueue_state_lock, flags);
+
+    if (!nv_workqueue_accepting)
+    {
+        spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+        return 0;
+    }
+
+    atomic_inc(&nv_workqueue_pending);
+
+    /* Queue before releasing the lock so shutdown cannot miss this item. */
+    queued = nvidia_wq_queue(work);
+    if (!queued)
+        wake = atomic_dec_and_test(&nv_workqueue_pending);
+
+    spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+
+    if (wake)
+        wake_up(&nv_workqueue_wait_queue);
+
+    return queued;
+}
+
+void NV_API_CALL nv_workqueue_complete(void)
+{
+    if (atomic_dec_and_test(&nv_workqueue_pending))
+        wake_up(&nv_workqueue_wait_queue);
+}
+
+void NV_API_CALL nv_workqueue_flush(void)
+{
+    wait_event(nv_workqueue_wait_queue,
+               atomic_read(&nv_workqueue_pending) == 0);
+
+    /* __flush_workqueue() waits for the callback itself to return. */
+    nv_workqueue_flush_private_queue();
+}
